<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ProcessForge</PackageId>
    <Version>1.0.1</Version>
    <Authors>curvecoder</Authors>
    <Company>curvecoder</Company>
    <Description>Cross-platform process inspector, command-line wrapper analyzer, and exclusion rule evaluator.</Description>
    <RepositoryUrl>https://github.com/curvecoder/NetFlowAudit</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\FRAMEWORK.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
